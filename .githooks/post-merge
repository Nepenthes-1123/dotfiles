#!/bin/sh
# vscode/extensions.txt が更新されていたら拡張をインストールする

DOTFILES_DIR="$(git rev-parse --show-toplevel)"

if git diff-tree -r --name-only ORIG_HEAD HEAD | grep -qx "vscode/extensions.txt"; then
    echo "VS Code extensions list has been updated."
    "$DOTFILES_DIR/scripts/dot.sh" vscode-extensions ||
        echo "Warning: Failed to install VS Code extensions. Please run scripts/dot.sh vscode-extensions manually."
fi
