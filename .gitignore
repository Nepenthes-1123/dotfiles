# 最初にすべての階層のファイルを無視します
# 階層は必要なだけ追加する
### all ignore ###
*

# 全てのディレクトリをホワイトリストに追加
!*/

# ホワイトリストに入れたいファイルを個別に許可
### not ignore ###
!README.md
!.gitignore
!.shellcheckrc
!.gitattributes
!bootstrap.sh
!bootstrap.ps1

# scripts セッティング
!scripts/**

# zsh セッティング
!zsh/.zshenv
!zsh/.zshrc
!zsh/.zsh.d/priorities.conf
!zsh/.zsh.d/audit.zsh
!zsh/.zsh.d/plugins.zsh
!zsh/.zsh.d/alias.zsh
!zsh/.zsh.d/completion.zsh
!zsh/.zsh.d/prompt.zsh
!zsh/.zsh.d/wezterm.zsh
!zsh/.zsh.d/mise.zsh
!zsh/.zprofile

# wezterm セッティング
!wezterm/WEZTERM_SETUP.md
!wezterm/.wezterm.lua
!wezterm/.wezterm/keybindings.lua
!wezterm/.wezterm/utils.lua
!wezterm/.wezterm/format.lua
!wezterm/.wezterm/status.lua
!wezterm/.wezterm/background.lua
!wezterm/.wezterm/kuyozakura.png
!wezterm/.wezterm/background_image.png

# 素材は非公開リポジトリ (dotfiles-assets) で管理するため追跡しない
wezterm/.wezterm/assets/

# vscode セッティング
!vscode/settings.json
!vscode/keybindings.json
!vscode/snippets/c.json
!vscode/snippets/latex.json

# git セッティング
!git/.gitconfig
!git/.gitconfig.private

# github セッティング
!.github/workflows/scripts.yml

